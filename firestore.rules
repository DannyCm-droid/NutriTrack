rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo el dueño de la cuenta puede leer y escribir su perfil.
    // request.auth.uid es el id de quien inició sesión. userId sale de la ruta users/{userId}.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // meals y weights cuelgan de ese usuario. La condición es la misma: ser el dueño.
      match /meals/{mealId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /weights/{weightId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
